---
import { works } from "@/data/works"
import Link from "./global/Link.astro"
---

<div
  id="work"
  class="mb-2 bg-gray-50 p-5 shadow-lg sm:rounded-xl md:max-w-screen-2xl lg:max-w-sm @dark:bg-gray-800"
>
  <div class="mb-2 text-lg">製作物 <i class="ri-macbook-line"></i></div>

  <div class="max-w-fit">
    <div class="flex flex-col space-y-1 pt-3">
      {
        works.map(work => (
          <div>
            <Link href={work.href} targetBlank>
              {work.title}<i class="ri-external-link-line"></i>
            </Link>
          </div>
        ))
      }
    </div>
  </div>
</div>
